# ============================================================
# .env.exemplo — MODELO das configurações (sem valores de verdade)
# ============================================================
# Como usar: copie este arquivo com o nome ".env" e preencha.
# O .env está no .gitignore: nunca vai para o GitHub.

# --- Bot no WhatsApp (conexao.js / npm start) ---

# Opcional: seu número pessoal, só dígitos (55 + DDD + número). Ex.: 5527999999999
# Mensagens vindas dele recebem o menu do dono. Se ficar vazio, o menu do dono
# fica no chat "Você" do próprio número conectado.
NUMERO_DINEI=

# Opcional, MODO TESTE: só responde estes números (separados por vírgula).
# Deixe vazio para responder todos os clientes.
SOMENTE_NUMEROS=

# Atender TODOS os clientes (sem modo teste). Só use no número da OFICINA (no servidor).
# Sem esta linha e sem SOMENTE_NUMEROS, o bot se recusa a ligar (proteção contra ligar
# sem querer num número pessoal).
# RESPONDER_TODOS=sim
